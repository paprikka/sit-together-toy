{
	"name": "sit-together",
	"version": "0.0.1",
	"private": true,
	"scripts": {
		"dev:client": "vite dev --host",
		"dev:api": "wrangler dev --ip 0.0.0.0",
		"deploy:api": "wrangler deploy",
		"dev": "pnpm concurrently 'pnpm dev:client' 'pnpm dev:api'",
		"build": "vite build",
		"preview": "vite preview",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test": "vitest",
		"lint": "prettier --plugin-search-dir . --check . && eslint .",
		"format": "prettier --plugin-search-dir . --write .",
		"check:api": "tsc -p party/tsconfig.json"
	},
	"devDependencies": {
		"@cloudflare/workers-types": "^5.20261013.1",
		"@sveltejs/adapter-vercel": "^3.1.0",
		"@sveltejs/kit": "^1.20.4",
		"@types/howler": "^2.2.10",
		"@types/lodash": "^4.14.200",
		"@types/three": "^0.157.2",
		"@typescript-eslint/eslint-plugin": "^6.0.0",
		"@typescript-eslint/parser": "^6.0.0",
		"concurrently": "^8.2.2",
		"eslint": "^8.28.0",
		"eslint-config-prettier": "^8.5.0",
		"eslint-plugin-svelte": "^2.30.0",
		"prettier": "^2.8.0",
		"prettier-plugin-svelte": "^2.10.1",
		"svelte": "^4.0.5",
		"svelte-check": "^3.4.3",
		"tslib": "^2.4.1",
		"typescript": "^5.0.0",
		"vite": "^4.4.2",
		"vitest": "^0.34.0",
		"wrangler": "^4.150.0"
	},
	"type": "module",
	"dependencies": {
		"howler": "^2.2.4",
		"lodash": "^4.17.21",
		"partyserver": "^0.5.10",
		"partysocket": "1.3.0"
	},
	"packageManager": "pnpm@12.6.0",
	"engines": {
		"node": ">=22"
	}
}
